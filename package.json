{
  "name": "codeowners-check",
  "description": "Enforces codeowners include the PR author as a potential owner",
  "version": "0.1.0",
  "author": "",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/DelfinaCare/codeowners-check",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DelfinaCare/codeowners-check.git"
  },
  "bugs": {
    "url": "https://github.com/DelfinaCare/codeowners-check/issues"
  },
  "keywords": [
    "actions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx oxlint",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npx rimraf ./dist ./build && npx rollup --config rollup.config.mjs",
    "package:watch": "npm run package -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "typecheck": "npx tsc --noEmit -p tsconfig.test.json",
    "all": "npm run format:write && npm run lint && npm run typecheck && npm run test && npm run coverage && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "minimatch": "^11.0.9"
  },
  "devDependencies": {
    "@github/local-action": "^7.0.1",
    "@jest/globals": "^30.5.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "make-coverage-badge": "^1.2.0",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "rollup": "^4.68.8",
    "rollup-plugin-sourcemaps2": "^0.5.10",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
